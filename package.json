{
  "name": "@abelspithost/conventional-commits-changelog",
  "version": "0.0.2",
  "description": "A conventional commits changelog and release tool with monorepo support",
  "keywords": [
    "conventional-changelog-monorepo",
    "conventional",
    "changelog",
    "release",
    "monorepo"
  ],
  "license": "ISC",
  "author": {
    "name": "Abel Spithost",
    "url": "https://github.com/aspithost"
  },
  "homepage": "https://github.com/aspithost/eslint-config-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aspithost/conventional-commits-changelog.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "release": "./dist/cli/release/cliRelease.js",
    "release-packages": "./dist/cli/release-packages/cliReleasePackages.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.spec.json && tsc -p tsconfig.build.json && npm run deps:check",
    "clean": "rimraf coverage && rimraf dist",
    "deps:check": "npx -y npm-check-updates --cooldown 2",
    "deps:update": "npx -y npm-check-updates -u --target minor --cooldown 2 && npm install",
    "deps:update:major": "npx -y npm-check-updates -u --cooldown 2 && npm install",
    "lint": "eslint . && npm run publint",
    "prepare": "husky || true",
    "publint": "npx -y publint",
    "release": "npx tsx release.config.ts",
    "release:dry-run": "npx tsx src/cli/release/cliRelease.ts --dry-run",
    "test:unit": "vitest",
    "test:cov": "vitest run --coverage --coverage.reporter=text",
    "test:cov:ci": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.spec.json"
  },
  "dependencies": {
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "conventional-changelog-writer": "^9.3.0",
    "conventional-commits-parser": "^7.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@abelspithost/commitlint": "^0.2.0",
    "@abelspithost/eslint-config-ts": "^3.2.1",
    "@abelspithost/tsconfig-node": "^0.1.2",
    "@abelspithost/vitest-config": "^0.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
