{
  "name": "@abelspithost/conventional-commits-changelog",
  "version": "0.0.0",
  "description": "",
  "keywords": [
    "conventional-changelog-monorepo",
    "conventional",
    "changelog",
    "monorepo"
  ],
  "license": "ISC",
  "author": {
    "name": "Abel Spithost",
    "url": "https://github.com/aspithost"
  },
  "homepage": "https://github.com/aspithost/eslint-config-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aspithost/conventional-commits-changelog.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.spec.json && tsc -p tsconfig.build.json && npm run deps:check",
    "clean": "rimraf coverage && rimraf dist",
    "deps:check": "npx -y npm-check-updates --cooldown 2",
    "deps:update": "npx -y npm-check-updates -u --target minor --cooldown 2 && npm install",
    "deps:update:major": "npx -y npm-check-updates -u --cooldown 2 && npm install",
    "lint": "eslint . && npm run publint",
    "prepare": "husky || true",
    "publint": "npx -y publint",
    "test:unit": "vitest",
    "test:cov": "vitest run --coverage --coverage.reporter=text",
    "test:cov:ci": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.spec.json"
  },
  "dependencies": {
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "conventional-changelog-writer": "^9.3.0",
    "conventional-commits-parser": "^7.1.3"
  },
  "devDependencies": {
    "@abelspithost/commitlint": "^0.1.10",
    "@abelspithost/eslint-config-ts": "^3.2.0",
    "@abelspithost/tsconfig-node": "^0.1.2",
    "@abelspithost/vitest-config": "^0.1.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}