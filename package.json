{
  "name": "@abelspithost/conventional-commits-changelog",
  "version": "0.0.0",
  "description": "",
  "main": "src/index.ts",
  "type": "module",
  "keywords": [
    "conventional-changelog-monorepo",
    "conventional",
    "changelog",
    "monorepo"
  ],
  "author": {
    "name": "Abel Spithost",
    "url": "https://github.com/aspithost"
  },
  "license": "ISC",
  "scripts": {
    "build": "npm run clean && npm run typecheck && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "deps:check": "npx -y npm-check-updates --cooldown 2",
    "deps:update": "npx -y npm-check-updates -u --target minor --cooldown 2 && npm install",
    "deps:update:major": "npx -y npm-check-updates -u --cooldown 2 && npm install",
    "lint": "eslint . && npm run publint",
    "publint": "npx -y publint",
    "test:unit": "vitest",
    "test:cov": "vitest run --coverage --coverage.reporter=text",
    "test:cov:ci": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "conventional-changelog-writer": "^8.4.0",
    "conventional-commits-parser": "^6.4.0"
  },
  "devDependencies": {
    "@abelspithost/commitlint": "^0.1.0",
    "@abelspithost/eslint-config-ts": "^1.1.1",
    "@abelspithost/tsconfig-node": "^0.0.5",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^24.12.4",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "handlebars": "^4.7.9",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  }
}
